# Copie para .env e ajuste.

# As máquinas agora são cadastradas na página "Máquinas" do Monitor (tipo, IP, VNC, senhas).
# Na primeira subida, se o cadastro estiver vazio, o Monitor importa UMA máquina das variáveis
# antigas abaixo (MACHINE_PROFILE, OPCUA_URL, MACHINE_NAME, OPCUA_NAMESPACE, VNC_*) e copia o
# histórico de DB_PATH. Depois disso elas não são mais lidas para escolher a máquina.
MACHINE_PROFILE=chy
OPCUA_URL=opc.tcp://10.202.148.102:4840
MACHINE_NAME=Injetora Chen Hsong (bancada)

# Cadastro de máquinas (SQLite) e pasta com o histórico/cache de tags de cada máquina.
CONFIG_DB_PATH=data/monitor_config.db
MACHINES_DIR=data/machines

# AMS Net ID deste servidor, para máquinas do tipo ads (Beckhoff). Vazio = não configurado.
ADS_LOCAL_NET_ID=

# Segundos entre leituras dos KPIs e alarmes / leitura completa das ~1000 variáveis.
POLL_SECONDS=5
FULL_POLL_SECONDS=60

# 1 = usa dados simulados (sem gateway). 0 = lê o gateway de verdade.
SIMULATE=0

# Onde guardar o histórico (SQLite) e por quantos dias.
DB_PATH=data/monitor.db
RETENTION_DAYS=7

# Tela ao vivo (VNC): host, porta e senhas de cada máquina ficam no cadastro (Máquinas).
# As senhas ficam só no servidor; o navegador nunca as recebe.
#   visualização: quem entra com ela só assiste
#   operação:     quem entra com ela pode assumir o controle (vazia = ninguém opera)
# Sem a de visualização, a Tela ao vivo fica desligada.
# VNC_ENABLED, VNC_HOST, VNC_PORT, VNC_VIEW_PASSWORD e VNC_CONTROL_PASSWORD só valem na importação inicial.
VNC_ENABLED=
VNC_HOST=
VNC_PORT=5900
VNC_VIEW_PASSWORD=
VNC_CONTROL_PASSWORD=

# Segundos sem mexer até o operador perder o controle e a tela voltar a só visualização.
VNC_CONTROL_TIMEOUT=300

# Porta VNC comum do Monitor, para o Espelho IHM ou outro cliente VNC (0 = desligada).
# O painel aceita um cliente só: aponte o Espelho para <IP do Monitor>:5901, não direto no painel.
VNC_TCP_PORT=5901

# Registro de quem entrou, assumiu e devolveu o controle.
VNC_AUDIT_PATH=data/vnc_audit.log

# Tela ao vivo da Beckhoff: o servidor roda o CERHOST.exe no Wine numa tela virtual e a serve
# por VNC só em 127.0.0.1. Precisa de: sudo apt-get install -y wine wine32:i386 xvfb openbox xdotool wmctrl x11vnc
# Vazio = tela da Beckhoff desligada (a Tela ao vivo avisa); os dados ADS seguem normais.
# Ligue a Tela ao vivo e defina as duas senhas VNC no cadastro da máquina ads (página Máquinas).
CERHOST_EXE=
# Número da tela virtual (Xvfb :99).
CERHOST_DISPLAY=99
# Prefixo Wine DEDICADO ao CERHost (opcional): só com ele o encerramento roda `wineserver -k`.
CERHOST_WINEPREFIX=
# Pids dos processos da ponte (a próxima subida encerra as sobras de um Monitor que caiu).
CERHOST_PIDFILE=data/cerhost.pids
