# Copie para .env e ajuste.

# Tipo de máquina:
#   chy  = painel CHY lido pelo gateway Mega CHL3200 (variáveis ns=1;s=Nome)
#   em63 = painel B&R com Euromap 63 (ex.: JM228), lido direto do painel ou pelo MC1
MACHINE_PROFILE=chy

# Endereço do servidor OPC-UA (gateway CHL3200 ou painel B&R).
#   CHY:  opc.tcp://<IP do gateway>:4840
#   JM228 pelo MC1: opc.tcp://192.168.10.100:4840   |   direto no cabo: opc.tcp://10.86.20.253:4840
OPCUA_URL=opc.tcp://10.202.148.102:4840

# Nome que aparece no topo do painel.
MACHINE_NAME=Injetora Chen Hsong (bancada)

# Segundos entre leituras dos KPIs e alarmes / leitura completa das ~1000 variáveis.
POLL_SECONDS=5
FULL_POLL_SECONDS=60

# 1 = usa dados simulados (sem gateway). 0 = lê o gateway de verdade.
SIMULATE=0

# Onde guardar o histórico (SQLite) e por quantos dias.
DB_PATH=data/monitor.db
RETENTION_DAYS=7

# Tela ao vivo (VNC do painel, só visualização). Ligada por padrão no perfil em63.
# VNC_HOST vazio = mesmo IP do OPCUA_URL.
VNC_ENABLED=
VNC_HOST=
VNC_PORT=5900
