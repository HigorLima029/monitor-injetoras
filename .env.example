# Copie para .env e ajuste.

# Endereço do servidor OPC-UA do gateway Mega (CHL3200).
OPCUA_URL=opc.tcp://10.202.148.102:4840

# Nome que aparece no topo do painel.
MACHINE_NAME=Injetora Chen Hsong (bancada)

# Segundos entre leituras dos KPIs e alarmes / leitura completa das ~1000 variáveis.
POLL_SECONDS=5
FULL_POLL_SECONDS=60

# 1 = usa dados simulados (sem gateway). 0 = lê o gateway de verdade.
SIMULATE=0

# Onde guardar o histórico (SQLite) e por quantos dias.
DB_PATH=data/monitor.db
RETENTION_DAYS=7
